PROVEDORES=gemini,mistral,openrouter
MAX_CHARS_TEXTO=300000

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Escolha um modelo gratuito em https://openrouter.ai/models?max_price=0
# (modelos com o sufixo ":free", por exemplo: google/gemma-4-27b:free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
